{
  "name": "fieldiq",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "node --env-file-if-exists=.env server/index.mjs",
    "dev": "node --env-file-if-exists=.env --watch server/index.mjs",
    "test": "node --test --test-concurrency=1 test/*.test.mjs",
    "db:init": "node --env-file-if-exists=.env scripts/database.mjs init",
    "db:export": "node --env-file-if-exists=.env scripts/database.mjs export",
    "admin:create": "node --env-file-if-exists=.env scripts/create-admin.mjs",
    "test:browser": "node test/browser.mjs",
    "check": "node scripts/check.mjs"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.16",
    "@fontsource-variable/inter": "^5.3.0",
    "chart.js": "4.4.1",
    "express": "5.3.0",
    "lucide": "^1.75.0",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "playwright": "1.65.1"
  }
}
