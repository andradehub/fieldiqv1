# Sem DATABASE_URL: PostgreSQL embutido (PGlite), persistido em .fieldiq/data.
PORT=4173
HOST=127.0.0.1
# DATABASE_URL=postgresql://usuario:senha@host:5432/fieldiq
# Em nuvem, configure TLS com certificado valido. Nunca desative verificacao TLS.
# PGSSLMODE=verify-full
# Em PostgreSQL remoto, os dados ficticios so sao criados com DEMO_MODE=1.
# DEMO_MODE=1
# DEMO_PASSWORD=defina-uma-senha-para-a-demonstracao-publicada
# A identificacao de recorrencias usa somente o historico local, sem LLM ou chave externa.

# Agendamento externo de notificacoes: segredo aleatorio com pelo menos 32 caracteres.
# CRON_SECRET=configure-no-ambiente-do-agendador-e-do-servidor
